                .a-items
                    h2 GET IN TOUCH
                    span.grey_line
                    p.des Lorem ipsum dolor sit amet, consetetur sadipscing elitr amet
                .flex
                    .information
                        +application(touch.address)
                        +application(touch.hotline)
                        +application(touch.eMail, "is")
                    .bot 
                        .form 
                            .inputs
                                input.item1(type="text", name="userName", placeholder="YOUR NAME") 
                                input.item2(type="text", name="userEmail", placeholder="YOUR E-MAIl") 
                                input.item3(type="text", name="subject", placeholder="YOUR SUBJECT") 
                                input.item4(type="text", name="companyName", placeholder="COMPANY NAME") 
                            textarea.item5(name="message" placeholder="WRITE YOUR MESSAGE")
                        .send 
                            button(type="submit") SEND MESSAGE
                            p 
                                span.star.red *  
                                | We’ll contact you as as possible. We don’t reply on Monday.
