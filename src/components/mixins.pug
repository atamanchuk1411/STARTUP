mixin post(oneCard, number="blog1")
    div.blog(class=number)
        picture 
            img(src=oneCard.img, alt=oneCard.alt)
        section 
            .location 
                div.left
                    p.num #{oneCard.left}
                    p ОСТ
                div 
                    h3 #{oneCard.title}
                    p.author 
                        | #{oneCard.author1} #{oneCard.space}
                        span #{oneCard.author2} #{oneCard.space}
                        | #{oneCard.author3} #{oneCard.space}
                        span #{oneCard.author4}
            p.post_des #{oneCard.description}
            a.read(href=oneCard.href) READ MORE

