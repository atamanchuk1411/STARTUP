mixin project(oneProject, picture="num1", block="red1")
    div(class=picture)
        div.redBackground.none(class=block)
        p.none(class=block) #{oneProject.caption}
        p.none(class=block) Branding
        div.none(class=block)
            a(href="#") VIEW
            span.chevron
        picture 
            img(src=oneProject.img, alt=oneProject.title)
        
